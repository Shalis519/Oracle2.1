# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file — it is gitignored.

# --- Database (required) ---
# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Authentication: Clerk (required) ---
# Backend keys (used by the API server).
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend key (used by the web app, must be prefixed with VITE_).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only set when using a Clerk proxy (e.g. a Replit-managed Clerk proxy).
# VITE_CLERK_PROXY_URL=https://your-clerk-proxy-url

# --- Provided automatically by the Replit runtime ---
# You normally do NOT need to set these by hand:
#   PORT, BASE_PATH, NODE_ENV, LOG_LEVEL, REPL_ID, REPLIT_DOMAINS
